# Database connection for local SQLite development
# Local development:
DATABASE_URL="file:./dev.db"
# Railway production deployment (with persistent volume mounted at /data):
# DATABASE_URL="file:/data/scholarscout.db"

# TinyFish API key for official scholarship discovery and content extraction
# Get an API key from https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY="your_tinyfish_api_key_here"

# Optional demo mode: set to "true" to load verified sample opportunities for offline UI demonstration
DEMO_MODE="false"
